#: schemas/messages.ts
msgctxt "MsWwGp"
msgid "Password must have at least 8 characters, including uppercase, lowercase, number and special character."
msgstr "Mật khẩu phải có ít nhất 8 ký tự, bao gồm chữ hoa, chữ thường, số và ký tự đặc biệt."

#: schemas/messages.ts
msgctxt "_1byDa"
msgid "Amount is required."
msgstr "Số tiền là bắt buộc."

#: schemas/messages.ts
msgctxt "HCzfe9"
msgid "Amount must be a valid number."
msgstr "Số tiền phải là một số hợp lệ."

#: schemas/messages.ts
msgctxt "ICgNGL"
msgid "Amount must be greater than 0."
msgstr "Số tiền phải lớn hơn 0."

#: schemas/messages.ts
msgctxt "9I9BOz"
msgid "Maximum amount is 100 billion."
msgstr "Số tiền tối đa là 100 tỷ."

#: schemas/messages.ts
msgctxt "aAADUG"
msgid "Username is required."
msgstr "Tên đăng nhập là bắt buộc."

#: schemas/messages.ts
msgctxt "gpW0lx"
msgid "Current password is required."
msgstr "Mật khẩu hiện tại là bắt buộc."

#: schemas/messages.ts
msgctxt "xfcapk"
msgid "New password confirmation is required."
msgstr "Xác nhận mật khẩu mới là bắt buộc."

#: schemas/messages.ts
msgctxt "H5adYw"
msgid "Passwords do not match."
msgstr "Mật khẩu không khớp."

#: schemas/messages.ts
msgctxt "RKK2dE"
msgid "Enter the 6-digit code from your authenticator app."
msgstr "Nhập mã 6 chữ số từ ứng dụng xác thực của bạn."

#: schemas/messages.ts
msgctxt "eX6daX"
msgid "Code must be at most 10 digits."
msgstr "Mã phải có tối đa 10 chữ số."

#: schemas/messages.ts
msgctxt "O4PhlQ"
msgid "Code can only contain digits."
msgstr "Mã chỉ có thể chứa các chữ số."

#: schemas/messages.ts
msgctxt "_4pQDl"
msgid "Name is required."
msgstr "Tên là bắt buộc."

#: schemas/messages.ts
msgctxt "YeRtBx"
msgid "Name must be at most 100 characters."
msgstr "Tên phải có tối đa 100 ký tự."

#: schemas/messages.ts
msgctxt "J0CJqe"
msgid "Name can only contain letters."
msgstr "Tên chỉ có thể chứa chữ cái."

#: schemas/messages.ts
msgctxt "c-1x_V"
msgid "Username must have at least 3 characters."
msgstr "Tên đăng nhập phải có ít nhất 3 ký tự."

#: schemas/messages.ts
msgctxt "MSqoQ2"
msgid "Username must be at most 30 characters."
msgstr "Tên đăng nhập phải có tối đa 30 ký tự."

#: schemas/messages.ts
msgctxt "8Y5qyI"
msgid "Username can only contain letters, numbers, underscores, and dots."
msgstr "Tên đăng nhập chỉ có thể chứa chữ cái, số, dấu gạch dưới và dấu chấm."

#: schemas/messages.ts
msgctxt "l9jjIW"
msgid "Transaction type is required."
msgstr "Loại giao dịch là bắt buộc."

#: schemas/messages.ts
msgctxt "uDAfoc"
msgid "Category is required."
msgstr "Danh mục là bắt buộc."

#: schemas/messages.ts
msgctxt "A5N1tw"
msgid "Currency is required."
msgstr "Tiền tệ là bắt buộc."

#: schemas/messages.ts
msgctxt "be3kp3"
msgid "Description is required."
msgstr "Mô tả là bắt buộc."

#: schemas/messages.ts
msgctxt "Y1VHB3"
msgid "Description must be at most 200 characters."
msgstr "Mô tả phải có tối đa 200 ký tự."

#: schemas/messages.ts
msgctxt "fgoR4w"
msgid "Date is required."
msgstr "Ngày là bắt buộc."

#: schemas/messages.ts
msgctxt "4zNmm0"
msgid "Transaction date cannot be in the future."
msgstr "Ngày giao dịch không thể ở tương lai."

#: schemas/messages.ts
msgctxt "goeMxG"
msgid "Type is required."
msgstr "Loại là bắt buộc."

#: schemas/messages.ts
msgctxt "5huJG4"
msgid "Category name is required."
msgstr "Tên danh mục là bắt buộc."

#: schemas/messages.ts
msgctxt "LmVuiu"
msgid "Category name must be at most 50 characters."
msgstr "Tên danh mục phải có tối đa 50 ký tự."

#: schemas/messages.ts
msgctxt "C3kWKK"
msgid "Start date is required."
msgstr "Ngày bắt đầu là bắt buộc."

#: schemas/messages.ts
msgctxt "1uO2me"
msgid "End date is required."
msgstr "Ngày kết thúc là bắt buộc."

#: schemas/messages.ts
msgctxt "hjtyTg"
msgid "End date must be after start date."
msgstr "Ngày kết thúc phải sau ngày bắt đầu."

#: schemas/messages.ts
msgctxt "eEFyJl"
msgid "Goal name is required."
msgstr "Tên mục tiêu là bắt buộc."

#: schemas/messages.ts
msgctxt "qVUStI"
msgid "Goal name must be at most 100 characters."
msgstr "Tên mục tiêu phải có tối đa 100 ký tự."

#: schemas/messages.ts
msgctxt "pmDGs3"
msgid "Frequency is required."
msgstr "Tần suất là bắt buộc."

#: schemas/messages.ts
msgctxt "rHlS-D"
msgid "Number of days is required."
msgstr "Số ngày là bắt buộc."

#: schemas/messages.ts
msgctxt "N4OgtE"
msgid "The number of days must not exceed 365."
msgstr "Số ngày không được vượt quá 365."

#: schemas/messages.ts
msgctxt "F8BDEm"
msgid "Cannot activate a recurring transaction that has already expired."
msgstr "Không thể kích hoạt giao dịch định kỳ đã hết hạn."

#: schemas/messages.ts
msgctxt "xs_MJu"
msgid "Please enter a valid email address."
msgstr "Vui lòng nhập địa chỉ email hợp lệ."

#: schemas/messages.ts
msgctxt "XCx5G5"
msgid "Role is required."
msgstr "Vai trò là bắt buộc."

#: schemas/messages.ts
msgctxt "JgUCtj"
msgid "Ban reason must be at most 200 characters."
msgstr "Lý do cấm phải có tối đa 200 ký tự."

#: schemas/messages.ts
msgctxt "Jb24zO"
msgid "Duration is required."
msgstr "Thời hạn là bắt buộc."
