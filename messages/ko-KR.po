#: schemas/messages.ts
msgctxt "MsWwGp"
msgid "Password must have at least 8 characters, including uppercase, lowercase, number and special character."
msgstr "비밀번호는 최소 8자 이상이어야 하며 대문자, 소문자, 숫자 및 특수 문자를 포함해야 합니다."

#: schemas/messages.ts
msgctxt "_1byDa"
msgid "Amount is required."
msgstr "금액은 필수입니다."

#: schemas/messages.ts
msgctxt "HCzfe9"
msgid "Amount must be a valid number."
msgstr "금액은 유효한 숫자여야 합니다."

#: schemas/messages.ts
msgctxt "ICgNGL"
msgid "Amount must be greater than 0."
msgstr "금액은 0보다 커야 합니다."

#: schemas/messages.ts
msgctxt "9I9BOz"
msgid "Maximum amount is 100 billion."
msgstr "최대 금액은 1000억입니다."

#: schemas/messages.ts
msgctxt "aAADUG"
msgid "Username is required."
msgstr "사용자 이름은 필수입니다."

#: schemas/messages.ts
msgctxt "gpW0lx"
msgid "Current password is required."
msgstr "현재 비밀번호는 필수입니다."

#: schemas/messages.ts
msgctxt "xfcapk"
msgid "New password confirmation is required."
msgstr "새 비밀번호 확인은 필수입니다."

#: schemas/messages.ts
msgctxt "H5adYw"
msgid "Passwords do not match."
msgstr "비밀번호가 일치하지 않습니다."

#: schemas/messages.ts
msgctxt "RKK2dE"
msgid "Enter the 6-digit code from your authenticator app."
msgstr "인증 앱의 6자리 코드를 입력하세요."

#: schemas/messages.ts
msgctxt "eX6daX"
msgid "Code must be at most 10 digits."
msgstr "코드는 최대 10자리 숫자여야 합니다."

#: schemas/messages.ts
msgctxt "O4PhlQ"
msgid "Code can only contain digits."
msgstr "코드는 숫자만 포함할 수 있습니다."

#: schemas/messages.ts
msgctxt "_4pQDl"
msgid "Name is required."
msgstr "이름은 필수입니다."

#: schemas/messages.ts
msgctxt "YeRtBx"
msgid "Name must be at most 100 characters."
msgstr "이름은 최대 100자입니다."

#: schemas/messages.ts
msgctxt "J0CJqe"
msgid "Name can only contain letters."
msgstr "이름은 문자만 포함할 수 있습니다."

#: schemas/messages.ts
msgctxt "c-1x_V"
msgid "Username must have at least 3 characters."
msgstr "사용자 이름은 최소 3자 이상이어야 합니다."

#: schemas/messages.ts
msgctxt "MSqoQ2"
msgid "Username must be at most 30 characters."
msgstr "사용자 이름은 최대 30자입니다."

#: schemas/messages.ts
msgctxt "8Y5qyI"
msgid "Username can only contain letters, numbers, underscores, and dots."
msgstr "사용자 이름은 문자, 숫자, 밑줄 및 점만 포함할 수 있습니다."

#: schemas/messages.ts
msgctxt "l9jjIW"
msgid "Transaction type is required."
msgstr "거래 유형은 필수입니다."

#: schemas/messages.ts
msgctxt "uDAfoc"
msgid "Category is required."
msgstr "카테고리는 필수입니다."

#: schemas/messages.ts
msgctxt "A5N1tw"
msgid "Currency is required."
msgstr "통화는 필수입니다."

#: schemas/messages.ts
msgctxt "be3kp3"
msgid "Description is required."
msgstr "설명은 필수입니다."

#: schemas/messages.ts
msgctxt "Y1VHB3"
msgid "Description must be at most 200 characters."
msgstr "설명은 최대 200자입니다."

#: schemas/messages.ts
msgctxt "fgoR4w"
msgid "Date is required."
msgstr "날짜는 필수입니다."

#: schemas/messages.ts
msgctxt "4zNmm0"
msgid "Transaction date cannot be in the future."
msgstr "거래 날짜는 미래 날짜일 수 없습니다."

#: schemas/messages.ts
msgctxt "goeMxG"
msgid "Type is required."
msgstr "유형은 필수입니다."

#: schemas/messages.ts
msgctxt "5huJG4"
msgid "Category name is required."
msgstr "카테고리 이름은 필수입니다."

#: schemas/messages.ts
msgctxt "LmVuiu"
msgid "Category name must be at most 50 characters."
msgstr "카테고리 이름은 최대 50자입니다."

#: schemas/messages.ts
msgctxt "C3kWKK"
msgid "Start date is required."
msgstr "시작일은 필수입니다."

#: schemas/messages.ts
msgctxt "1uO2me"
msgid "End date is required."
msgstr "종료일은 필수입니다."

#: schemas/messages.ts
msgctxt "hjtyTg"
msgid "End date must be after start date."
msgstr "종료일은 시작일 이후여야 합니다."

#: schemas/messages.ts
msgctxt "eEFyJl"
msgid "Goal name is required."
msgstr "목표 이름은 필수입니다."

#: schemas/messages.ts
msgctxt "qVUStI"
msgid "Goal name must be at most 100 characters."
msgstr "목표 이름은 최대 100자입니다."

#: schemas/messages.ts
msgctxt "pmDGs3"
msgid "Frequency is required."
msgstr "빈도는 필수입니다."

#: schemas/messages.ts
msgctxt "rHlS-D"
msgid "Number of days is required."
msgstr "일수는 필수입니다."

#: schemas/messages.ts
msgctxt "N4OgtE"
msgid "The number of days must not exceed 365."
msgstr "일수는 365를 초과할 수 없습니다."

#: schemas/messages.ts
msgctxt "F8BDEm"
msgid "Cannot activate a recurring transaction that has already expired."
msgstr "이미 만료된 반복 거래는 활성화할 수 없습니다."

#: schemas/messages.ts
msgctxt "xs_MJu"
msgid "Please enter a valid email address."
msgstr "유효한 이메일 주소를 입력해 주세요."

#: schemas/messages.ts
msgctxt "XCx5G5"
msgid "Role is required."
msgstr "역할은 필수입니다."

#: schemas/messages.ts
msgctxt "JgUCtj"
msgid "Ban reason must be at most 200 characters."
msgstr "차단 사유는 최대 200자여야 합니다."

#: schemas/messages.ts
msgctxt "Jb24zO"
msgid "Duration is required."
msgstr "기간은 필수입니다."
